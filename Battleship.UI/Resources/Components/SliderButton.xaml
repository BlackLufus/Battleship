<UserControl
  x:Class="Battleship.UI.Resources.Components.SliderButton"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:Battleship.UI.Resources.Components"
  mc:Ignorable="d"
>
  <Slider>
    <Slider.Style>
      <Style TargetType="Slider">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Slider">
              <Border
                Height="35"
                Background="White"
                BorderBrush="DarkGray"
                BorderThickness="2"
                CornerRadius="8"
              >
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition MinWidth="40px" Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition MinWidth="40px" Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Label
                    Grid.Column="0"
                    Content="{Binding MinValue, RelativeSource={RelativeSource AncestorType={x:Type local:SliderButton}}}"
                    Padding="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="20"
                    FontWeight="Bold"
                    Foreground="Black"
                  />
                  <Slider
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Value="{Binding StartValue, RelativeSource={RelativeSource AncestorType={x:Type local:SliderButton}}}"
                    Minimum="{Binding MinValue, RelativeSource={RelativeSource AncestorType={x:Type local:SliderButton}}}"
                    Maximum="{Binding MaxValue, RelativeSource={RelativeSource AncestorType={x:Type local:SliderButton}}}"
                    IsSnapToTickEnabled="True"
                    TickFrequency="1"
                    ValueChanged="Slider_ValueChanged"
                    PreviewMouseDown="Slider_MouseDown"
                    PreviewMouseUp="Slider_MouseUp"
                    Loaded="Slider_Loaded"
                  />
                  <Canvas
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    Visibility="Collapsed"
                    Loaded="Canvas_Loaded"
                  >
                    <Border
                      Background="Blue"
                      Width="40"
                      BorderThickness="2"
                      CornerRadius="5"
                      Canvas.Left="-20"
                      Canvas.Top="-35"
                    >
                      <Label
                        Content="0"
                        HorizontalContentAlignment="Center"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="White"
                        Loaded="Label_Loaded"
                      />
                    </Border>
                  </Canvas>
                  <Label
                    Grid.Column="2"
                    Content="{Binding MaxValue, RelativeSource={RelativeSource AncestorType={x:Type local:SliderButton}}}"
                    Padding="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="20"
                    FontWeight="Bold"
                    Foreground="Black"
                  />
                </Grid>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </Slider.Style>
  </Slider>
</UserControl>
