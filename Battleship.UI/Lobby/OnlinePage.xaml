<Page
  x:Class="Battleship.UI.Lobby.OnlinePage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:Battleship.UI.Lobby"
  xmlns:components="clr-namespace:Battleship.UI.Resources.Components"
  mc:Ignorable="d"
  d:DesignHeight="450"
  d:DesignWidth="800"
  Title="OnlinePage"
>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="50px" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="50px" />
    </Grid.ColumnDefinitions>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="65" />
        <RowDefinition Height="30" />
        <RowDefinition Height="*" />
        <RowDefinition Height="10" />
        <RowDefinition Height="50" />
      </Grid.RowDefinitions>
      <TextBlock
        Grid.Row="0"
        Text="Onlinemodus"
        FontSize="38"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Foreground="White"
      />
      <Grid Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0 20">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Grid.Row="0" Background="#4467F1A9" Padding="50 40">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="5" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal">
              <RadioButton
                x:Name="PublicRadioButton"
                GroupName="GameMode"
                Style="{StaticResource RadioButtonStyle}"
                Content="Öffentlich"
                FontSize="24"
                VerticalAlignment="Center"
                VerticalContentAlignment="Center"
                Foreground="White"
                IsChecked="True"
                Click="OnlineModusClick"
              />
              <RadioButton
                x:Name="PrivateRadioButton"
                GroupName="GameMode"
                Style="{StaticResource RadioButtonStyle}"
                Content="Lokal"
                FontSize="24"
                VerticalAlignment="Center"
                VerticalContentAlignment="Center"
                Foreground="White"
                Click="OnlineModusClick"
              />
            </StackPanel>
            <!-- Public settings over mqtt broker -->
            <Grid Grid.Row="2" Visibility="Visible" x:Name="PublicSettings">
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Label
                Grid.Row="0"
                Grid.Column="0"
                Content="Spiel-ID"
                FontSize="24"
                FontWeight="Bold"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Foreground="#EEE"
              />
              <Grid Grid.Row="2" Grid.Column="0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <components:Input
                  Grid.Column="0"
                  x:Name="GameId"
                  Placeholder="z.B. Game_0815"
                  FontSize="24"
                  Width="Auto"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Center"
                  MaxChars="16"
                />
              </Grid>
              <Label
                Grid.Row="4"
                Grid.Column="0"
                Content="Password"
                FontSize="24"
                FontWeight="Bold"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Foreground="#EEE"
              />
              <Grid Grid.Row="6" Grid.Column="0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <components:Input
                  Grid.Column="0"
                  x:Name="Password"
                  Placeholder="z.b. abcdefghijklmnop"
                  FontSize="24"
                  Width="Auto"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Center"
                  MaxChars="16"
                />
              </Grid>
            </Grid>

            <!-- Private settigs over a direct tcp connection -->
            <Grid Grid.Row="2" Visibility="Hidden" x:Name="PrivateSettings">
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Label
                Grid.Row="0"
                Grid.Column="0"
                Content="IP Addresse"
                FontSize="24"
                FontWeight="Bold"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Foreground="#EEE"
              />
              <Grid Grid.Row="2" Grid.Column="0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <components:Input
                  Grid.Column="0"
                  x:Name="IPAddressInput"
                  Placeholder="z.B. 192.168.x.x"
                  FontSize="24"
                  Width="Auto"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Center"
                  MaxChars="15"
                />
              </Grid>
              <Label
                Grid.Row="4"
                Grid.Column="0"
                Content="Port"
                FontSize="24"
                FontWeight="Bold"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Foreground="#EEE"
              />
              <Grid Grid.Row="6" Grid.Column="0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <components:Input
                  Grid.Column="0"
                  x:Name="PortInput"
                  Placeholder="z.B. 5000"
                  FontSize="24"
                  Width="Auto"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Center"
                  MaxChars="5"
                />
              </Grid>
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <Grid Grid.Row="4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Button
          Grid.Column="0"
          x:Name="ConnectButton"
          Content="Verbinden"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Click="ConnectButtonClick"
        />
        <Button
          Grid.Column="1"
          x:Name="PrivateGameButton"
          Content="Spiel Erstellen"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Click="PrivateGameButton_Click"
        />
        <Button
          Grid.Column="2"
          Content="Zurück"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Click="BackButton_Click"
        />
      </Grid>
    </Grid>
  </Grid>
</Page>
