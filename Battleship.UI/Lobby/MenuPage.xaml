<Page
  x:Class="Battleship.UI.Lobby.MenuPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:Battelship.UI.Lobby"
  xmlns:components="clr-namespace:Battleship.UI.Resources.Components"
  mc:Ignorable="d"
  d:DesignHeight="450"
  d:DesignWidth="800"
  Title="MenuPage"
>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="50px" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="50px" />
    </Grid.ColumnDefinitions>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="65" />
        <RowDefinition Height="30" />
        <RowDefinition Height="300" />
      </Grid.RowDefinitions>
      <TextBlock
        Grid.Row="0"
        Text="Hauptmenü"
        FontSize="38"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Foreground="White"
      />
      <Grid Grid.Row="2" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
          <RowDefinition Height="142" />
          <RowDefinition Height="20" />
          <RowDefinition Height="142" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="260" />
          <ColumnDefinition Width="20" />
          <ColumnDefinition Width="260" />
        </Grid.ColumnDefinitions>
        <components:MenuButton
          Grid.Column="0"
          Grid.Row="0"
          ImageSource="pack://application:,,,/Resources/Images/singelplayer.png"
          Text="Einzelspieler"
          Click="SingelPlayerButton_MouseLeftButtonDown"
        />
        <components:MenuButton
          Grid.Column="2"
          Grid.Row="0"
          ImageSource="pack://application:,,,/Resources/Images/multiplayer.png"
          Text="Duos"
          Click="DuosButton_MouseLeftButtonDown"
        />
        <components:MenuButton
          Grid.Column="0"
          Grid.Row="2"
          ImageSource="pack://application:,,,/Resources/Images/online.png"
          Text="Online"
          Click="OnlineButton_MouseLeftButtonDown"
        />
        <components:MenuButton
          Grid.Column="2"
          Grid.Row="2"
          ImageSource="pack://application:,,,/Resources/Images/load-file.png"
          Text="Spiel Laden"
          Click="LoadGameButton_MouseLeftButtonDown"
        />
      </Grid>
    </Grid>
  </Grid>
</Page>
