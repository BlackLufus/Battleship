<Window
  x:Class="Battleship.UI.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:local="clr-namespace:Battleship.UI"
  xmlns:components="clr-namespace:Battleship.UI.Resources.Components"
  mc:Ignorable="d"
  Closing="Window_Closing"
  Title="MainWindow"
  Height="550"
  Width="900"
  MinHeight="550"
  MinWidth="900"
>
  <Grid>
    <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden" />
    <Grid x:Name="DialogContainer" Background="#8000" Visibility="Collapsed">
      <Viewbox>
        <Grid Width="900" Height="550">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid
            Grid.Row="0"
            Grid.Column="0"
            Name="DialogGrid"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
          ></Grid>
        </Grid>
      </Viewbox>
    </Grid>
  </Grid>
</Window>
