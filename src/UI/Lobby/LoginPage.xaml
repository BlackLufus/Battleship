<Page
  x:Class="Battleship.Lobby.LoginPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:Battleship.Lobby"
  xmlns:components="clr-namespace:Battleship.Resources.Components"
  mc:Ignorable="d"
  d:DesignHeight="550"
  d:DesignWidth="900"
  Title="LoginPage"
>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="50px" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="50px" />
    </Grid.ColumnDefinitions>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="65" />
        <RowDefinition Height="30" />
        <RowDefinition Height="10" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="AUto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock
        Grid.Row="0"
        Text="Schiffe Versenken V2"
        FontSize="38"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Foreground="#FFECFFEC"
      />
      <Grid Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0 20">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Grid.Row="0" Background="#4467F1A9" Padding="50 40">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="20" />
              <RowDefinition Height="*" />
              <RowDefinition Height="20" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Label
              Grid.Row="0"
              Grid.Column="0"
              Content="Wähle einen Nutzername"
              FontSize="24"
              FontWeight="Bold"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Foreground="#EEE"
            />
            <Grid Grid.Row="2" Grid.Column="0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <components:Input
                Grid.Column="0"
                x:Name="UsernameInput"
                Placeholder="User_1234"
                FontSize="24"
                Width="Auto"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
              />
            </Grid>
            <Button Grid.Row="4" Content="Bestätigen" Click="applyButton_Click" />
          </Grid>
        </Border>
      </Grid>
      <Grid Grid.Row="4" Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Label
          Grid.Row="0"
          Content="© 2024 Battleship. All Rights Reserved | Version: 2.0"
          FontSize="12"
          Foreground="White"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Margin="0 5 0 0"
        />
      </Grid>
    </Grid>
  </Grid>
</Page>
