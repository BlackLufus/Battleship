<Page
  x:Class="Battleship.UI.Game.GamePage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:Battleship.UI.Game"
  xmlns:components="clr-namespace:Battleship.Resources.Components"
  xmlns:userControl="clr-namespace:Battleship.Resources.userControls"
  mc:Ignorable="d"
  d:DesignHeight="450"
  d:DesignWidth="800"
  Title="GamePage"
>
  <Grid>
    <Image
      Source="pack://application:,,,/Resources/Images/background1.jpg"
      Stretch="UniformToFill"
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      Panel.ZIndex="-1"
    />
    <Viewbox>
      <Border Background="#8222" Padding="0">
        <Grid Margin="50 0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="720" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="380" />
            <RowDefinition Height="140" />
            <RowDefinition Height="30" />
          </Grid.RowDefinitions>
          <userControl:MenuBar Grid.Row="0" />
          <Grid Grid.Row="1" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
              <RowDefinition Height="20" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="320" />
              <ColumnDefinition Width="100" />
              <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>
            <Border
              Grid.Row="1"
              Grid.Column="0"
              Height="340"
              Width="310"
              Background="#252525"
              CornerRadius="10"
              HorizontalAlignment="Right"
            >
              <StackPanel Height="340" Width="300">
                <Grid Height="35">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Label
                    Grid.Column="1"
                    Content="Gegner:"
                    Foreground="White"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Padding="0"
                  />
                  <Label
                    Grid.Column="3"
                    x:Name="OpponentUsername"
                    Content="Spieler 1"
                    Foreground="White"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Padding="0"
                  />
                </Grid>
                <Grid VerticalAlignment="Center">
                  <Grid
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    ClipToBounds="True"
                    VerticalAlignment="Center"
                    SnapsToDevicePixels="True"
                  >
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="300" />
                    </Grid.RowDefinitions>
                    <Grid.Clip>
                      <RectangleGeometry Rect="0, 0, 300, 300" RadiusX="6" RadiusY="6" />
                    </Grid.Clip>
                    <Grid x:Name="EnemyWaterGrid" Background="#FF002684">
                      <!-- Enemy Level 1: Water Grid -->
                    </Grid>
                  </Grid>

                  <Canvas x:Name="EnemyShipCanvas" Grid.Column="0">
                    <!-- Enemy Level 2: Drag Ships -->
                  </Canvas>

                  <Grid Grid.Column="1" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="300" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="EnemyCellGrid" MaxWidth="300" MaxHeight="300">
                      <!-- Enemy Level 3: Cell State Grid -->
                    </Grid>
                  </Grid>

                  <Grid Grid.Column="1" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="300" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="EnemyTargetGrid" MaxWidth="300" MaxHeight="300">
                      <!-- Enemy Level 4: Enemy Target Grid -->
                    </Grid>
                  </Grid>
                </Grid>
              </StackPanel>
            </Border>
            <Border
              Grid.Row="1"
              Grid.Column="2"
              Height="340"
              Width="310"
              Background="#252525"
              CornerRadius="12"
              HorizontalAlignment="Left"
            >
              <StackPanel Height="340" Width="300">
                <Grid Height="35">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Label
                    Grid.Column="1"
                    Content="Dein Feld:"
                    Foreground="White"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Padding="0"
                  />
                  <Label
                    Grid.Column="3"
                    x:Name="PlayerUsername"
                    Content="Spieler 2"
                    Foreground="White"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Padding="0"
                  />
                </Grid>
                <Grid VerticalAlignment="Center">
                  <Grid
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    ClipToBounds="True"
                    VerticalAlignment="Center"
                    SnapsToDevicePixels="True"
                  >
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="300" />
                    </Grid.RowDefinitions>
                    <Grid.Clip>
                      <RectangleGeometry Rect="0, 0, 300, 300" RadiusX="6" RadiusY="6" />
                    </Grid.Clip>
                    <Grid x:Name="FriendlyWaterGrid" Background="#FF002684">
                      <!-- Enemy Level 1: Water Grid -->
                    </Grid>
                  </Grid>

                  <Canvas x:Name="FriendlyShipCanvas" Grid.Column="0">
                    <!-- Enemy Level 2: Drag Ship Grid -->
                  </Canvas>

                  <Grid Grid.Column="1" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="300" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="FriendlyCellGrid" MaxWidth="300" MaxHeight="300">
                      <!-- Enemy Level 3: Cell State Grid -->
                    </Grid>
                  </Grid>

                  <Grid Grid.Column="1" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="300" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="FriendlyTargetGrid" MaxWidth="300" MaxHeight="300">
                      <!-- Enemy Level 4: Enemy Target Grid -->
                    </Grid>
                  </Grid>
                </Grid>
              </StackPanel>
            </Border>
          </Grid>
          <!-- Chat (Input and Output) -->
          <userControl:Chat Grid.Row="2" x:Name="Chat" />
          <!-- Extras -->
          <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Label Grid.Column="2" Content="Zeit: 14:15:00 - 08.10.2014" Foreground="White" />
          </Grid>
        </Grid>
      </Border>
    </Viewbox>
  </Grid>
</Page>
