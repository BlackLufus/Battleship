<UserControl
  x:Class="Battleship.Resources.userControls.Chat"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:Battleship.Resources.userControls"
  xmlns:chatComponents="clr-namespace:Battleship.Resources.userControls.chatComponents"
  mc:Ignorable="d"
>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border
      x:Name="RootBorder"
      Grid.Column="1"
      BorderBrush="#252525"
      BorderThickness="3"
      CornerRadius="10"
    >
      <Grid ClipToBounds="True" Background="#252525" SizeChanged="Grid_SizeChanged">
        <Grid.RowDefinitions>
          <RowDefinition MinHeight="40" Height="*" />
          <RowDefinition Height="23" />
        </Grid.RowDefinitions>
        <Grid.Clip>
          <RectangleGeometry x:Name="ClipRect" Rect="0, 0, 234, 134" RadiusX="8" RadiusY="8" />
        </Grid.Clip>
        <ScrollViewer
          Grid.Row="0"
          x:Name="ScrollView"
          VerticalAlignment="Stretch"
          Margin="0"
          Padding="0"
          VerticalContentAlignment="Top"
          VerticalScrollBarVisibility="Auto"
        >
          <StackPanel x:Name="MessagesContainer" />
        </ScrollViewer>
        <Border Grid.Row="1" BorderBrush="#252525" BorderThickness="0 3 0 0">
          <Grid Background="#525252">
            <Grid.ColumnDefinitions>
              <ColumnDefinition MinWidth="50" Width="*" />
              <ColumnDefinition Width="15" />
              <ColumnDefinition Width="20" />
            </Grid.ColumnDefinitions>
            <TextBox
              Grid.Column="0"
              x:Name="InputMessage"
              Text="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}}"
              FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
              Foreground="#eee"
              Background="Transparent"
              TextAlignment="Left"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              VerticalContentAlignment="Center"
              BorderThickness="0"
              Loaded="TextBox_Loaded"
              GotFocus="TextBox_GotFocus"
              LostFocus="TextBox_LostFocus"
              KeyDown="TextBox_KeyDown"
            />
            <Button Grid.Column="1" Click="DeleteButton_Click">
              <Button.Style>
                <Style TargetType="Button">
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" BorderThickness="0">
                          <Image
                            x:Name="InputImage"
                            Source="pack://application:,,,/Resources/Images/Components/delete.png"
                            Margin="0 1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Opacity="0.5"
                          />
                        </Border>
                        <ControlTemplate.Triggers>
                          <MultiTrigger>
                            <MultiTrigger.Conditions>
                              <Condition Property="IsMouseOver" Value="True" />
                              <Condition Property="IsMouseCaptured" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="InputImage" Property="Opacity" Value="0.3" />
                          </MultiTrigger>
                          <MultiTrigger>
                            <MultiTrigger.Conditions>
                              <Condition Property="IsMouseOver" Value="True" />
                              <Condition Property="IsPressed" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter
                              TargetName="InputImage"
                              Property="Source"
                              Value="pack://application:,,,/Resources/Images/Components/delete-hover.png"
                            />
                          </MultiTrigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </Button.Style>
            </Button>
            <Button Grid.Column="4" Click="SendButton_Click">
              <Button.Style>
                <Style TargetType="Button">
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" BorderThickness="0">
                          <Image
                            x:Name="InputImage"
                            Source="pack://application:,,,/Resources/Images/Components/send.png"
                            Margin="0 1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Opacity="0.5"
                          />
                        </Border>
                        <ControlTemplate.Triggers>
                          <MultiTrigger>
                            <MultiTrigger.Conditions>
                              <Condition Property="IsMouseOver" Value="True" />
                              <Condition Property="IsMouseCaptured" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="InputImage" Property="Opacity" Value="0.3" />
                          </MultiTrigger>
                          <MultiTrigger>
                            <MultiTrigger.Conditions>
                              <Condition Property="IsMouseOver" Value="True" />
                              <Condition Property="IsPressed" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter
                              TargetName="InputImage"
                              Property="Source"
                              Value="pack://application:,,,/Resources/Images/Components/send-hover.png"
                            />
                          </MultiTrigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </Button.Style>
            </Button>
          </Grid>
        </Border>
      </Grid>
    </Border>
    <Border
      Grid.Column="1"
      Background="#252525"
      HorizontalAlignment="Center"
      VerticalAlignment="Top"
      Height="Auto"
      Width="Auto"
      Margin="0 -13 0 0"
    >
      <Border.CornerRadius>
        <CornerRadius TopLeft="10" TopRight="10" BottomRight="0" BottomLeft="0" />
      </Border.CornerRadius>
      <Label
        Content="Chat"
        Foreground="White"
        HorizontalAlignment="Center"
        VerticalAlignment="Top"
        Padding="20 0"
      />
    </Border>
  </Grid>
</UserControl>
