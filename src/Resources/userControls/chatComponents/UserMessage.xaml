<UserControl
  x:Class="Battleship.Resources.userControls.chatComponents.UserMessage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:Battleship.Resources.userControls.chatComponents"
  mc:Ignorable="d"
>
  <Grid Background="#525252" Height="20" Margin="0">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="5" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="4" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Label
      Grid.Column="1"
      Content="{Binding Username, RelativeSource={RelativeSource AncestorType=UserControl}}"
      Foreground="Orange"
      FontWeight="DemiBold"
      Padding="0"
    />
    <Label Grid.Column="2" Content="" HorizontalAlignment="Center" Foreground="White" Padding="0" />
    <Label
      Grid.Column="3"
      Content="{Binding Message, RelativeSource={RelativeSource AncestorType=UserControl}}"
      Foreground="White"
      Padding="0"
    />
    <Grid.Style>
      <Style TargetType="Grid">
        <Setter Property="Opacity" Value="1" />
        <Style.Triggers>
          <MultiTrigger>
            <MultiTrigger.Conditions>
              <Condition Property="IsMouseOver" Value="True" />
              <Condition Property="IsMouseCaptured" Value="False" />
            </MultiTrigger.Conditions>
            <Setter Property="Opacity" Value="0.9" />
          </MultiTrigger>
        </Style.Triggers>
      </Style>
    </Grid.Style>
  </Grid>
</UserControl>
