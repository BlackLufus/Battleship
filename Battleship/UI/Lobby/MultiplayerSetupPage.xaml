<Page x:Class="Battleship.Lobby.MultiplayerSetupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Battleship.Lobby" xmlns:components="clr-namespace:Battleship.Resources.Components"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MultiplayerSetup">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50px" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="50px" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="65" />
                <RowDefinition Height="30" />
                <RowDefinition Height="*" />
                <RowDefinition Height="10" />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Verbindungseinstellungen" FontSize="38" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
            <Grid Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0 20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Row="0" Background="#4467F1A9" Padding="50 40">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="20" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Label Grid.Row="0" Grid.Column="0" Content="Wähle eine IP-Addresse" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#EEE" />
                        <Grid Grid.Row="2" Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <components:Input Grid.Column="0" x:Name="AddressInput" Placeholder="192.168.178.100" FontSize="24" Width="Auto" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Grid>
                        <Label Grid.Row="4" Grid.Column="0" Content="Wähle einen Port" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#EEE" />
                        <Grid Grid.Row="6" Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <components:Input Grid.Column="0" x:Name="PortInput" Placeholder="8080" FontSize="24" Width="Auto" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Beitreten" HorizontalAlignment="Center" VerticalAlignment="Center" Click="JoinButton_Click"/>
                <Button Grid.Column="1" Content="Spiel erstellen" HorizontalAlignment="Center" VerticalAlignment="Center" Click="HostButton_Click"/>
                <Button Grid.Column="2" Content="Zurück" HorizontalAlignment="Center" VerticalAlignment="Center" Click="BackButton_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Page>
