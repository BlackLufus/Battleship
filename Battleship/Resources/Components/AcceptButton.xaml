<UserControl x:Class="Battleship.Resources.Components.AcceptButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Battleship.Resources.Components"
             mc:Ignorable="d" 
             Width="35" Height="35" >
    <Grid>
        <Button Width="35" Height="35" Click="Button_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border
                        Background="Transparent" 
                        BorderThickness="0" >
                        <!-- ContentPresenter direkt hier verwenden -->
                        <Image x:Name="AcceptImage" Source="pack://application:,,,/Resources/Images/Components/accept.png" Width="35" Height="35" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="AcceptImage" Property="Width" Value="30" />
                            <Setter TargetName="AcceptImage" Property="Height" Value="30" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="AcceptImage" Property="Width" Value="30" />
                            <Setter TargetName="AcceptImage" Property="Height" Value="30" />
                            <Setter TargetName="AcceptImage" Property="Opacity" Value="0.8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>

</UserControl>
