<Window x:Class="Battleship.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Battleship"
        mc:Ignorable="d"
        Closing="Window_Closing"
        Title="MainWindow" Height="550" Width="900" MinHeight="550" MinWidth="900">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="pack://application:,,,/Resources/Images/background2.jpg"/>
        </Grid.Background>
        <Viewbox>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="25" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="25" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24px" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24px" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="1" BorderBrush="Black" BorderThickness="2" CornerRadius="15" 
                                    Background="#4C000000" Padding="10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Frame x:Name="mainFrame" NavigationUIVisibility="Hidden" Height="425" Width="780" />
                    </Border>
                </Grid>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="35" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20" />
                        <RowDefinition Height="50" />
                    </Grid.RowDefinitions>
                    <Button Grid.Column="3" Grid.Row="1" Style="{StaticResource MainWindowButtonStyle}" Click="Settings_Click" VerticalAlignment="Top">
                        <Image Source="pack://application:,,,/Resources/Images/settings.png" Width="50" Height="50" />
                    </Button>
                </Grid>
            </Grid>
        </Viewbox>
    </Grid>
</Window>
