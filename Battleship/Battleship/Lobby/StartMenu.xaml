<Page x:Class="Battleship.Lobby.StartMenu"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Battelship.Lobby"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Lobby">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50px" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="50px" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="65" />
                <RowDefinition Height="30" />
                <RowDefinition Height="300"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Schiffe Versenken" FontSize="38" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Border Grid.Row="1" Background="#222222" CornerRadius="2" Margin="0 8 0 18" />
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50" />
                    <RowDefinition Height="50" />
                    <RowDefinition Height="50" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Button Grid.Row="0" Content="Einzelspieler" FontSize="24" Width="240" HorizontalAlignment="Center" VerticalAlignment="Center" Click="singelPlayerButton_Click" />
                <Button Grid.Row="1" Content="Mehrspieler" FontSize="24" Width="240" HorizontalAlignment="Center" VerticalAlignment="Center" Click="multiPlayerButton_Click" />
                <Button Grid.Row="2" Content="Spiel Laden" FontSize="24" Width="240" HorizontalAlignment="Center" VerticalAlignment="Center" Click="loadGameButton_Click" />
            </Grid>
        </Grid>
    </Grid>
</Page>
