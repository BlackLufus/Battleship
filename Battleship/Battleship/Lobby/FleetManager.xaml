<Page x:Class="Battelship.Lobby.FleetManager"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Battelship.Lobby"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      AllowDrop="True"
      DragOver="Page_DragOver"
      Title="FleetManager">

    <Grid x:Name="container">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50px" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="50px" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="65" />
                <RowDefinition Height="30" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Setze alle Schiffe auf das Feld" FontSize="38" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Border Grid.Row="1" Background="#222222" CornerRadius="2" Margin="0 8 0 18" />
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="160" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="1" HorizontalAlignment="Center" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="280" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="ImageGrid" Background="#FF002684">

                    </Grid>
                </Grid>

                <Canvas x:Name="ShipsCanvas" Grid.Column="0" Background="Aqua">
                    <Image x:Name="Battleship" Width="56" Height="28" MouseDown="DragShip_MouseDown" Canvas.Left="50" Canvas.Top="10">
                        <Image.Source>
                            <BitmapImage UriSource="Pack://application:,,,/Resources/Images/battleship.png" Rotation="Rotate270"/>
                        </Image.Source>
                    </Image>
                    <Image x:Name="Cruiser" Width="84" Height="28" MouseDown="DragShip_MouseDown" Canvas.Left="36" Canvas.Top="74">
                        <Image.Source>
                            <BitmapImage UriSource="Pack://application:,,,/Resources/Images/cruiser.png" Rotation="Rotate270"/>
                        </Image.Source>
                    </Image>
                    <Image x:Name="Submarine" Width="126" Height="28" MouseDown="DragShip_MouseDown" Canvas.Left="17" Canvas.Top="153">
                        <Image.Source>
                            <BitmapImage UriSource="Pack://application:,,,/Resources/Images/Submarine.png" Rotation="Rotate270"/>
                        </Image.Source>
                    </Image>
                    <Image x:Name="Destroyer" Width="168" Height="28" MouseDown="DragShip_MouseDown" Canvas.Left="-4" Canvas.Top="242">
                        <Image.Source>
                            <BitmapImage UriSource="Pack://application:,,,/Resources/Images/destroyer.png" Rotation="Rotate270"/>
                        </Image.Source>
                    </Image>
                </Canvas>
                
                <Grid Grid.Column="1" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="280" />
                    </Grid.RowDefinitions>
                    <Canvas Width="280" Height="280" Background="#33000000">
                        <Image x:Name="ShipImage" Source="Pack://application:,,,/Resources/Images/ship-size-3.png" Width="28" Height="84" Canvas.Left="90" Canvas.Top="60"  />
                    </Canvas>
                    <Grid x:Name="DragAndDropGrid" MaxWidth="280" MaxHeight="280">

                    </Grid>
                </Grid>
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Button Grid.Row="1" Content="Fertig" FontSize="24" Width="140" HorizontalAlignment="Center" VerticalAlignment="Center" Click="finishButton_Click" />
                    <Button Grid.Row="2" Content="Zufällig" FontSize="24" Width="140" HorizontalAlignment="Center" VerticalAlignment="Center" Click="randomButton_Click" />
                    <Button Grid.Row="3" Content="Zurücksetzen" FontSize="24" Width="140" HorizontalAlignment="Center" VerticalAlignment="Center" Click="resetButton_Click" />
                    <Button Grid.Row="4" Content="Abbruch" FontSize="24" Width="140" HorizontalAlignment="Center" VerticalAlignment="Center" Click="cancelButton_Click" />
                    <Button Grid.Row="4" Content="Zurück" FontSize="24" Width="140" HorizontalAlignment="Center" VerticalAlignment="Center" Click="backButton_Click" />
                </Grid>
            </Grid>
            <Canvas Grid.Row="2">
            </Canvas>
        </Grid>
    </Grid>
</Page>
