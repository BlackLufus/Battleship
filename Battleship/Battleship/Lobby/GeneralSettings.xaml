<Page x:Class="Battleship.Lobby.GeneralSettings"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Battleship.Lobby"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="GeneralSettings">

    <Grid x:Name="container">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50px" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="50px" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="65" />
                <RowDefinition Height="30" />
                <RowDefinition Height="*" />
                <RowDefinition Height="10" />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Allgemeine Einstellungen" FontSize="38" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Border Grid.Row="1" Background="#222222" CornerRadius="2" Margin="0 8 0 18" />
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="50" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50" />
                    <RowDefinition Height="50" />
                    <RowDefinition Height="50" />
                    <RowDefinition Height="50" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Sprache:" FontSize="24" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="White" />
                <ComboBox Grid.Row="0" Grid.Column="3" x:Name="LanguageComboBox" FontSize="24" HorizontalAlignment="Left" VerticalAlignment="Center" Width="200" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="Dunkelmodus:" FontSize="24" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="White" />
                <Button Grid.Row="1" Grid.Column="3" x:Name="DarkModeButton" Content="Aktivieren" FontSize="24" HorizontalAlignment="Left" VerticalAlignment="Center" Width="200" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="Musik:" FontSize="24" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="White" />
                <Slider Grid.Row="2" Grid.Column="3" x:Name="MusicSlider" HorizontalAlignment="Left" VerticalAlignment="Center" Width="200" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="Sound Effekte:" FontSize="24" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="White" />
                <Slider Grid.Row="3" Grid.Column="3" x:Name="SoundEffectsSlider" HorizontalAlignment="Left" VerticalAlignment="Center" Width="200" />
            </Grid>
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="ResetSettingsButton" Content="Zurücksetzen" FontSize="24" Width="220" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Button Grid.Column="2" x:Name="BackButton" Content="Zurück" FontSize="24" Width="220" HorizontalAlignment="Center" VerticalAlignment="Center" Click="BackButton_Click" />
            </Grid>
        </Grid>
    </Grid>
</Page>
